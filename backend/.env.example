# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
# ---------------------------------------------------------------------------

# Clave de Google AI Studio (https://aistudio.google.com/apikey). Obligatoria.
# La usa XiloScan (identificacion de maderas).
GEMINI_API_KEY=tu_clave_aqui

# Clave de BioScan (identificacion de especies). Opcional pero MUY recomendable que sea
# de OTRO proyecto de Google Cloud: el nivel gratuito limita 20 peticiones diarias por
# modelo y por proyecto, asi que con una sola clave las dos apps se reparten las mismas
# ~160 consultas al dia. Vacio = usa la de arriba y comparten cuota.
GEMINI_API_KEY_ESPECIES=

# Clave de NutriFoto (calorias por foto). Mismo caso que la anterior: si la dejas vacia
# la app funciona, pero se come la cuota diaria de XiloScan y BioScan.
GEMINI_API_KEY_COMIDA=

# Origenes web autorizados (separados por coma) para llamar al backend desde un
# navegador. Solo lo necesita NutriFoto, que es web; las apps nativas no pasan por CORS.
# Vacio = cualquier origen. Ejemplo:
# ORIGENES_PERMITIDOS=https://nutrifoto.vercel.app,https://localhost
ORIGENES_PERMITIDOS=

# Cadena de modelos. El nivel gratuito permite 20 analisis al dia POR MODELO, asi que
# cuando uno se agota el backend pasa al siguiente y la capacidad diaria se multiplica.
# Vacio = cadena por defecto (8 modelos). GEMINI_MODEL, si existe, la encabeza.
GEMINI_MODELOS=

# Tokens de razonamiento antes de responder (0 lo desactiva).
GEMINI_THINKING=4096

# Puerto y host del servidor local.
PORT=3000
HOST=0.0.0.0

# Limite de tamano de imagen aceptado desde la app (MB).
MAX_IMAGE_MB=8

# Timeout de la llamada a Gemini (ms) y reintentos ante 429/503.
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

# Rate limit en memoria por IP (protege la cuota del nivel gratuito).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Secreto compartido opcional: si lo defines, la app Android debe enviar
# la cabecera `X-App-Key` con este valor. Dejalo vacio para desactivarlo.
APP_API_KEY=
