        android:pathData="M44,38c-9,1 -15,7 -16,15c-0.5,4 0.5,7 2,10c3,-6 8,-11 14,-14c-4,3 -8,8 -10,13c3,1 7,1 10,0c6,-2 10,-8 10,-15C54,42 50,38 44,38z" />

