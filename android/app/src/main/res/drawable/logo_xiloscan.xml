        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M80,98 L92,98 A6,6 0 0,0 98,92 L98,80"
        android:strokeColor="#7CB342"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

