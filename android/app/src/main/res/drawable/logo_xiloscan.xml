<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca de XiloScan: disco de madera con sus anillos, marco de escaneo alrededor
    y lupa con hoja. Vectorial para que sirva igual en el icono, en la bienvenida y
    en cualquier tamano sin pixelarse.
-->
